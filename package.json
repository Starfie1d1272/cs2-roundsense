{
  "name": "cs2-roundsense",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "RoundSense — read-only real-time decision-assist research for CS2: C4 time estimation and personal economy advisor",
  "license": "MIT",
  "type": "module",
  "scripts": {
