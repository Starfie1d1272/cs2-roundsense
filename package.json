{
  "name": "cs2-roundsense",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "description": "RoundSense — read-only real-time decision-assist research for CS2: C4 time estimation and personal economy advisor",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "recorder": "pnpm --filter @roundsense/gsi-recorder start",
    "validate": "pnpm --filter @roundsense/tools validate",
    "hud": "pnpm --filter @roundsense/roundsense hud",
    "hud:scenarios": "tsx scripts/hud-scenarios.ts",
    "format": "prettier --write \"{apps,packages,scripts,tools}/**/*.{ts,tsx,js,mjs,cjs}\" --ignore-unknown",
    "format:check": "prettier --check \"{apps,packages,scripts,tools}/**/*.{ts,tsx,js,mjs,cjs}\" --ignore-unknown",
    "lint": "biome lint apps packages scripts tools --diagnostic-level=error"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.11",
    "jszip": "^3.10.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.9.1"
  }
}
