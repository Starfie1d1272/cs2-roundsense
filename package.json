    "recorder": "pnpm --filter @roundsense/gsi-recorder start",
    "validate": "pnpm --filter @roundsense/tools validate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jszip": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}