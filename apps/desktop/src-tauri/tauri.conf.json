{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoundSense",
  "version": "0.1.1",
  "identifier": "dev.roundsense.hud",
  "build": {
    "frontendDist": "dist-empty"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "overlay",
          "description": "Geometry lease for the HUD window. Match the HTTP IPC origin and the fallback page URL.",
          "windows": ["overlay"],
          "remote": {
            "urls": ["http://127.0.0.1:3100/", "http://127.0.0.1:3100/overlay"]
          },
          "permissions": ["allow-set-overlay-state"]
        },
        {
          "identifier": "settings",
          "description": "Local Settings window: HUD placement preview and native folder commands.",
          "windows": ["settings"],
          "remote": {
            "urls": ["http://127.0.0.1:3100/"]
          },
          "permissions": [
            "allow-preview-overlay-geometry",
            "allow-pick-cs2-folder",
            "allow-open-directory",
            "allow-open-logs-dir"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
