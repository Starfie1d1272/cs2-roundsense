{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoundSense",
  "version": "0.1.0",
  "identifier": "dev.roundsense.hud",
  "build": {
    "frontendDist": "../../roundsense/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "overlay",
          "description": "Local HUD only; no filesystem, shell, or game-process modification capabilities.",
          "windows": ["overlay"],
          "remote": {
            "urls": ["http://127.0.0.1:3100/overlay"]
          },
          "permissions": []
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
